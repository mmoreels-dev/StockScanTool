@page "/"
@inject ApiService Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject ILogger<LoginPage> Logger

<LoginCard Subtitle="Barcode Scanner">
    <IconContent>
        <img src="media/logo.svg" alt="MM" width="36" height="36" />
    </IconContent>
    <ChildContent>
        <MudTextField @bind-Value="serverUrl"
                      Label="Server Address"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Dns"
                      Variant="Variant.Outlined"
                      Margin="Margin.Normal"
                      Required="true"
                      placeholder="http://192.168.1.100:5168" />

        <MudTextField @bind-Value="apiKey"
                      Label="Device API Key"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.VpnKey"
                      Variant="Variant.Outlined"
                      Margin="Margin.Normal"
                      InputType="InputType.Password"
                      Required="true"
                      placeholder="Enter your device API key" />

        <ErrorAlert Message="@error" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Size="Size.Large"
                   Disabled="@loading"
                   OnClick="Login"
                   Style="margin-top:16px;border-radius:8px;font-weight:600;text-transform:none;">
            @if (loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="color:white;margin-right:8px;" />
                <span>Connecting...</span>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Cable" Style="margin-right:8px;" />
                <span>Connect</span>
            }
        </MudButton>
    </ChildContent>
</LoginCard>

@code {
    private string serverUrl = "";
    private string apiKey = "";
    private string error = "";
    private bool loading;

    private async Task Login()
    {
        if (string.IsNullOrWhiteSpace(serverUrl) || string.IsNullOrWhiteSpace(apiKey))
        {
            error = "Please enter both fields.";
            return;
        }

        loading = true;
        error = "";

        Api.SetBaseUrl(serverUrl);
        try
        {
            var success = await Api.LoginAsync(apiKey);

            if (success)
            {
                Snackbar.Add("Connected to " + Api.StoreName, Severity.Success);
                Nav.NavigateTo("/scanner");
            }
            else
            {
                Logger.LogWarning("Login returned false — the device was not found or the server returned an error.");
                error = "Invalid API key, device inactive, or server error. Check the server and try again.";
            }
        }
        catch (UnauthorizedAccessException)
        {
            Logger.LogWarning("Server returned 401 — invalid API key or inactive device");
            error = "Invalid API key or device inactive.";
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Network error connecting to {Url}", serverUrl);
            error = "Could not reach server. Check the URL and ensure the server is running.";
        }
        catch (TaskCanceledException)
        {
            Logger.LogWarning("Connection timed out for {Url}", serverUrl);
            error = "Connection timed out. Check the server URL.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error during login");
            error = $"Connection failed: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }
}
