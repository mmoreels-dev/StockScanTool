@page "/scanner"
@inject ApiService Api
@inject NavigationManager Nav
@implements IAsyncDisposable
@inject StockScanTool.Shared.Services.BarcodeScannerService Scanner
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService Dialog

@if (!Api.IsAuthenticated)
{
    <div class="not-auth">
        <MudText Typo="Typo.h5" Style="color:white;font-weight:600;margin-bottom:8px;">Not connected.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GoLogin" Style="text-transform:none;">
            Go to Login
        </MudButton>
    </div>
}
else
{
    <div class="scanner-layout">
        <MudAppBar Elevation="0" Style="background:#1A1A2E;border-bottom:2px solid #FF6D00;">
            <div style="display:flex;align-items:center;gap:10px;">
                <img src="media/logo.svg" alt="MM" width="28" height="28" style="border-radius:6px;" />
                <div>
                    <MudText Typo="Typo.body2" Style="color:white;font-weight:600;line-height:1.2;">@Api.StoreName</MudText>
                    <MudText Typo="Typo.caption" Style="color:#8888aa;line-height:1.2;">@Api.DeviceName</MudText>
                </div>
            </div>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit"
                           OnClick="Logout" title="Logout" />
        </MudAppBar>

        <div class="camera-container">
            <div id="barcode-reader"></div>
            @if (!string.IsNullOrEmpty(scannerStatus))
            {
                <div class="scanner-status">@scannerStatus</div>
            }

            @if (lastScan is not null)
            {
                <div class="scan-overlay" @onclick="() => lastScan = null">
                    <MudPaper Class="scan-card" @onclick:stopPropagation>
                        <MudText Typo="Typo.h5" Style="font-weight:600;margin-bottom:4px;">@lastScan.Name</MudText>
                        <MudText Typo="Typo.h4" Style="font-weight:700;color:#FF6D00;margin-bottom:4px;">@lastScan.Price.ToString("C")</MudText>
                        <MudText Typo="Typo.caption" Style="color:#999;margin-bottom:16px;display:block;">SKU: @lastScan.Sku</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   OnClick="AddToCart" Style="text-transform:none;">
                            <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart" Style="margin-right:6px;" />
                            Add to Cart
                        </MudButton>
                    </MudPaper>
                </div>
            }
        </div>

        <div class="scanner-bottombar">
            <div class="cart-info">
                <MudText Typo="Typo.caption" Style="color:#666;">@cart.Count item(s)</MudText>
                <MudText Typo="Typo.body1" Style="font-weight:700;color:#FF6D00;">@cart.Sum(c => c.Total).ToString("C")</MudText>
            </div>
            <div class="cart-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                           Disabled="@(cart.Count == 0)" OnClick="OpenCart"
                           Style="text-transform:none;">
                    View Cart
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@(cart.Count == 0)" OnClick="Checkout"
                           Style="text-transform:none;">
                    Checkout
                </MudButton>
            </div>
        </div>
    </div>
}

@code {
    private List<CartItem> cart = new();
    private BarcodeLookupResponse? lastScan;
    private string scannerStatus = "Initializing scanner...";

    protected override async Task OnInitializedAsync()
    {
        Scanner.OnBarcodeDetected += OnBarcodeDetected;
        await Api.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Api.IsAuthenticated)
        {
            scannerStatus = "Starting barcode scanner...";
            await InvokeAsync(StateHasChanged);
            try
            {
                await Scanner.StartScanningAsync("barcode-reader");
                scannerStatus = "Scanner ready. Point the camera at a barcode.";
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                scannerStatus = $"Camera error: {ex.Message}";
                Snackbar.Add(scannerStatus, Severity.Error);
            }
        }
    }

    private async Task OnBarcodeDetected(string barcode)
    {
        try
        {
            if (lastScan is not null) return;

            await Scanner.StopScanningAsync();

            var product = await Api.LookupBarcodeAsync(barcode);
            if (product is null)
            {
                Snackbar.Add($"Barcode not found: {barcode}", Severity.Error);
                await Scanner.StartScanningAsync("barcode-reader");
                return;
            }

            lastScan = product;
            await InvokeAsync(StateHasChanged);
        }
        catch (UnauthorizedAccessException)
        {
            Nav.NavigateTo("/");
        }
    }

    private async Task AddToCart()
    {
        if (lastScan is null) return;

        var existing = cart.FirstOrDefault(c => c.ProductId == lastScan.Id);
        if (existing is not null)
            existing.Quantity++;
        else
            cart.Add(new CartItem
            {
                ProductId = lastScan.Id,
                Name = lastScan.Name,
                Barcode = lastScan.Barcode,
                Price = lastScan.Price,
                Quantity = 1
            });

        Snackbar.Add($"{lastScan.Name} added to cart", Severity.Success);
        lastScan = null;
        try { await Scanner.StartScanningAsync("barcode-reader"); } catch { /* scanner will restart on next scan */ }
    }

    private async Task Checkout()
    {
        try
        {
            if (cart.Count == 0) return;

            var confirm = await JS.InvokeAsync<bool>("confirm",
                $"Complete sale for {cart.Count} item(s) totalling {cart.Sum(c => c.Total):C}?");
            if (!confirm) return;

            var result = await Api.SubmitSaleAsync(cart);
            if (result is not null)
            {
                Snackbar.Add($"Sale #{result.Id} complete — {result.TotalAmount:C}", Severity.Success);
                cart.Clear();
            }
            else
            {
                Snackbar.Add("Sale failed — check stock levels.", Severity.Error);
            }
        }
        catch (UnauthorizedAccessException)
        {
            Nav.NavigateTo("/");
        }
    }

    private async Task OpenCart()
    {
        var parameters = new DialogParameters<List<CartItem>>
        {
            { "Cart", cart }
        };

        var dialog = await Dialog.ShowAsync<CartDialog>("Shopping Cart", parameters,
            new DialogOptions
            {
                FullWidth = true,
                MaxWidth = MaxWidth.Small,
                Position = DialogPosition.Center,
                CloseButton = true
            });

        var result = await dialog.Result;
        if (result?.Data is bool checkout && checkout)
        {
            await Checkout();
        }
    }

    private async Task Logout()
    {
        await Scanner.StopScanningAsync();
        await Api.Logout();
        Nav.NavigateTo("/");
    }

    private void GoLogin() => Nav.NavigateTo("/");

    public async ValueTask DisposeAsync()
    {
        Scanner.OnBarcodeDetected -= OnBarcodeDetected;
        await Scanner.StopScanningAsync();
        GC.SuppressFinalize(this);
    }
}
