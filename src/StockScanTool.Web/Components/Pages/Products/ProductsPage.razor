@page "/products"
@rendermode InteractiveServer
@using StockScanTool.Web.Services
@inject ApiClient Api
@inject IJSRuntime JS
@implements IDisposable

<h3>Product Management</h3>

@if (showForm)
{
    <div class="form-card">
        <h4>@(editingId is null ? "Add New Product" : "Edit Product")</h4>
        <div class="form-grid">
            <div class="form-group">
                <label>SKU</label>
                <input @bind="sku" placeholder="e.g. PROD-001" />
            </div>
            <div class="form-group">
                <label>Name</label>
                <input @bind="name" placeholder="Product name" />
            </div>
            <div class="form-group">
                <label>Barcode</label>
                <div style="display:flex;gap:8px;align-items:center;">
                    <input @bind="barcode" placeholder="e.g. 5901234123457" style="flex:1;" />
                    <button type="button" class="btn btn-sm btn-primary" @onclick="ScanBarcode" disabled="@scanning">
                        @if (scanning) { <span>Scanning...</span> }
                        else { <span>📷 Scan</span> }
                    </button>
                </div>
                <div id="admin-barcode-reader" style="width:100%;max-width:400px;margin-top:8px;@(scanning ? "" : "display:none;")"></div>
            </div>
            <div class="form-group">
                <label>Price</label>
                <input type="number" step="0.01" @bind="price" />
            </div>
        </div>
        <div class="form-group" style="max-width:600px; margin-bottom:16px;">
            <label>Description</label>
            <input @bind="description" placeholder="Product description" />
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="Save"
                    disabled="@(string.IsNullOrWhiteSpace(sku) || string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(barcode) || price <= 0)">Save</button>
            <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
        </div>
        @if (!string.IsNullOrEmpty(error))
        {
            <p class="error">@error</p>
        }
    </div>
}

@if (!showForm)
{
    <button class="btn btn-primary" @onclick="NewProduct">+ Add Product</button>
}

@if (products is null)
{
    <p>Loading...</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr><th>ID</th><th>SKU</th><th>Name</th><th>Barcode</th><th>Price</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var p in products)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.Sku</td>
                    <td>@p.Name</td>
                    <td><code>@p.Barcode</code></td>
                    <td>@p.Price.ToString("C")</td>
                    <td>
                        <button class="btn btn-sm" @onclick="() => Edit(p)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => Delete(p.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ProductDto>? products;
    private bool showForm;
    private int? editingId;
    private string error = "";
    private bool scanning;

    private string sku = "", name = "", barcode = "", description = "";
    private decimal price;

    private DotNetObjectReference<ProductsPage>? _dotNetRef;
    private bool _needsScan;

    protected override async Task OnInitializedAsync()
    {
        try { products = await Api.GetProducts(); }
        catch { error = "Could not connect to the API. Make sure the API server is running."; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_needsScan)
        {
            _needsScan = false;
            _dotNetRef ??= DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("adminScanner.scanOnce", _dotNetRef); }
            catch (Exception ex) { error = $"Camera error: {ex.Message}"; scanning = false; await InvokeAsync(StateHasChanged); }
        }
    }

    private void NewProduct()
    {
        editingId = null; sku = name = barcode = description = ""; price = 0;
        showForm = true; error = "";
    }

    private void Edit(ProductDto p)
    {
        editingId = p.Id; sku = p.Sku; name = p.Name; barcode = p.Barcode; description = p.Description; price = p.Price;
        showForm = true; error = "";
    }

    private void Cancel() { showForm = false; error = ""; }

    private async Task Save()
    {
        try
        {
            var req = new CreateProductRequest(sku, name, description, barcode, price);
            if (editingId is null)
                await Api.CreateProduct(req);
            else
                await Api.UpdateProduct(editingId.Value, new UpdateProductRequest(sku, name, description, barcode, price));
            showForm = false;
            products = await Api.GetProducts();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Delete(int id)
    {
        try { await Api.DeleteProduct(id); products = await Api.GetProducts(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private void ScanBarcode()
    {
        scanning = true;
        _needsScan = true;
    }

    [JSInvokable]
    public async Task OnBarcodeScanned(string value)
    {
        barcode = value;
        scanning = false;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
        _ = JS.InvokeVoidAsync("adminScanner.stop");
    }
}
