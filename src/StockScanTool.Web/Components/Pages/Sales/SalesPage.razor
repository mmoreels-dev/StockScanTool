@page "/sales"
@inject ApiClient Api
@inject AuthStateService AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Sales - StockScanTool</PageTitle>

<PageHeader Title="Sales History" />

@if (loading)
{
    <div style="display:flex;justify-content:center;padding:48px;">
        <MudProgressCircular Size="Size.Large" Indeterminate="true" Color="Color.Primary" />
    </div>
}
else if (!string.IsNullOrEmpty(error))
{
    <ErrorAlert Message="@error" />
}
else
{
    <MudDataGrid T="SaleTransactionDto" Items="@FilteredSales" Hover="true" Dense="true"
                 SortMode="SortMode.Single" Elevation="2" Style="border-radius:12px;overflow:hidden;"
                 Filterable="true" Groupable="false"
                 RowClick="RowClicked" HoverRowOnHover="true">
        <ToolBarContent>
            <MudSelect T="int" @bind-Value="filterStoreId" Label="Filter by Store" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Style="max-width:200px;" Clearable="true">
                <MudSelectItem Value="0">All Stores</MudSelectItem>
                @foreach (var s in stores)
                {
                    <MudSelectItem Value="@s.Id">@s.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSpacer />
            <MudText Typo="Typo.body2" Style="color:#757575;align-self:center;">
                @FilteredSales.Count() transaction(s) | Total: @FilteredSales.Sum(s => s.TotalAmount).ToString("C")
            </MudText>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Id" Title="ID" />
            <PropertyColumn Property="x => x.StoreName" Title="Store" />
            <PropertyColumn Property="x => x.DeviceName" Title="Device" />
            <TemplateColumn Title="Items">
                <CellTemplate>
                    @context.Item.Items.Sum(i => i.Quantity)
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.TotalAmount" Title="Total" Format="C" />
            <PropertyColumn Property="x => x.SaleDate" Title="Date" Format="g" />
        </Columns>
        <NoRecordsContent>
            <MudText Style="padding:16px;color:#757575;">No sales found.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="SaleTransactionDto" PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudDataGrid>

    @if (selectedSale is not null)
    {
        <MudDivider Style="margin:24px 0;" />
        <MudPaper Elevation="2" Style="padding:20px;border-radius:12px;">
            <MudText Typo="Typo.h6" Style="font-weight:600;margin-bottom:12px;">
                <MudIcon Icon="@Icons.Material.Filled.Receipt" Style="margin-right:8px;vertical-align:middle;" />
                Transaction #@selectedSale.Id — @selectedSale.StoreName
            </MudText>
            <MudText Typo="Typo.body2" Style="color:#757575;margin-bottom:16px;">
                @selectedSale.SaleDate.ToString("g") · @selectedSale.DeviceName · Total: @selectedSale.TotalAmount.ToString("C")
            </MudText>
            <MudDataGrid T="SaleItemDto" Items="@selectedSale.Items" Hover="true" Dense="true"
                         SortMode="SortMode.None" Elevation="0">
                <Columns>
                    <PropertyColumn Property="x => x.ProductName" Title="Product" />
                    <PropertyColumn Property="x => x.Quantity" Title="Qty" />
                    <PropertyColumn Property="x => x.PriceAtTimeOfSale" Title="Price" Format="C" />
                    <TemplateColumn Title="Subtotal">
                        <CellTemplate>
                            @((context.Item.Quantity * context.Item.PriceAtTimeOfSale).ToString("C"))
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        </MudPaper>
    }
}

@code {
    private List<SaleTransactionDto>? sales;
    private List<StoreDto> stores = new();
    private string error = "";
    private bool loading = true;
    private int filterStoreId;
    private SaleTransactionDto? selectedSale;

    private IEnumerable<SaleTransactionDto> FilteredSales => sales?.Where(s =>
        filterStoreId == 0 || s.StoreId == filterStoreId
    ) ?? [];

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        if (!AuthState.IsAuthenticated) { Nav.NavigateTo("/login", forceLoad: true); return; }
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        try
        {
            stores = (await Api.GetStores()).ToList();
            sales = (await Api.GetSales()).ToList();
            error = "";
        }
        catch (UnauthorizedAccessException) { Nav.NavigateTo("/login", forceLoad: true); return; }
        catch { error = "Could not connect to the API."; }
        loading = false;
    }

    private void RowClicked(DataGridRowClickEventArgs<SaleTransactionDto> args)
    {
        selectedSale = args.Item;
    }
}
