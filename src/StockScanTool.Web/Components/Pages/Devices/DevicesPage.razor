@page "/devices"
@inject ApiClient Api
@inject AuthStateService AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Devices - StockScanTool</PageTitle>

<PageHeader Title="Devices" ButtonText="Add Device" ButtonIcon="@Icons.Material.Filled.Add" OnAdd="NewDevice" />

@if (loading)
{
    <div style="display:flex;justify-content:center;padding:48px;">
        <MudProgressCircular Size="Size.Large" Indeterminate="true" Color="Color.Primary" />
    </div>
}
else if (!string.IsNullOrEmpty(error))
{
    <ErrorAlert Message="@error" />
}
else
{
    <MudDataGrid T="DeviceDto" Items="@FilteredDevices" Hover="true" Dense="true"
                 SortMode="SortMode.Single" Elevation="2" Style="border-radius:12px;overflow:hidden;"
                 Filterable="true" Groupable="false">
        <ToolBarContent>
            <MudTextField @bind-Value="searchText" Placeholder="Search devices..."
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium" Class="mt-0" Immediate="true"
                          DebounceInterval="300" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Style="max-width:300px;" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.DeviceName" Title="Device Name" />
            <PropertyColumn Property="x => x.StoreName" Title="Store" />
            <PropertyColumn Property="x => x.IsActive" Title="Status">
                <CellTemplate>
                    @if (context.Item.IsActive)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Active</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">Inactive</MudChip>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.LastPing" Title="Last Ping">
                <CellTemplate>
                    @(context.Item.LastPing?.ToString("g") ?? "Never")
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="Actions" Sortable="false" Filterable="false" Align="Align.End">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                   OnClick="() => Edit(context.Item)" Title="Edit" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="() => Delete(context.Item)" Title="Delete" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Style="padding:16px;color:#757575;">No devices found.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="DeviceDto" PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    private List<DeviceDto>? devices;
    private List<StoreDto> stores = new();
    private string error = "";
    private bool loading = true;
    private string searchText = "";

    private IEnumerable<DeviceDto> FilteredDevices => devices?.Where(d =>
        string.IsNullOrEmpty(searchText) ||
        d.DeviceName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
        d.StoreName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
    ) ?? [];

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        if (!AuthState.IsAuthenticated) { Nav.NavigateTo("/login", forceLoad: true); return; }
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        try
        {
            devices = (await Api.GetDevices()).ToList();
            stores = (await Api.GetStores()).ToList();
            error = "";
        }
        catch (UnauthorizedAccessException) { Nav.NavigateTo("/login", forceLoad: true); return; }
        catch { error = "Could not connect to the API."; }
        loading = false;
    }

    private void NewDevice() => ShowDialog(null);
    private void Edit(DeviceDto device) => ShowDialog(device);

    private async Task ShowDialog(DeviceDto? device)
    {
        var parameters = new DialogParameters<DeviceDialog>
        {
            { x => x.Device, device },
            { x => x.Stores, stores },
            { x => x.OnSave, EventCallback.Factory.Create(this, LoadData) }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<DeviceDialog>(device == null ? "Add Device" : "Edit Device", parameters, options);
    }

    private async Task Delete(DeviceDto device)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Delete Device",
            $"Are you sure you want to delete \"{device.DeviceName}\"?",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed == true)
        {
            try
            {
                await Api.DeleteDevice(device.Id);
                Snackbar.Add("Device deleted.", Severity.Success);
                await LoadData();
            }
            catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        }
    }
}
