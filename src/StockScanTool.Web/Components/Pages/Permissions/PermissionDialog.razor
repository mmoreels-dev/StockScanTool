@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight:600;">
            <MudIcon Icon="@Icons.Material.Filled.LockOpen" Style="margin-right:8px;" />
            @(IsEdit ? "Edit Permission" : "Add Permission")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="code" Label="Code" Variant="Variant.Outlined"
                      Required="true" Margin="Margin.Normal" Placeholder="e.g. reports.view" />
        <MudTextField @bind-Value="name" Label="Name" Variant="Variant.Outlined"
                      Required="true" Margin="Margin.Normal" Placeholder="e.g. View Reports" />
        <MudTextField @bind-Value="groupName" Label="Group" Variant="Variant.Outlined"
                      Required="true" Margin="Margin.Normal" Placeholder="e.g. Reports" />
        <MudTextField @bind-Value="description" Label="Description" Variant="Variant.Outlined"
                      Margin="Margin.Normal" Lines="2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined" Style="text-transform:none;">Cancel</MudButton>
        <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Primary" Disabled="@saving"
                   Style="text-transform:none;">
            @if (saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="margin-right:8px;" /> }
            @(IsEdit ? "Update" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public PermissionDto? Permission { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }

    private bool IsEdit => Permission is not null;
    private string code = "";
    private string name = "";
    private string groupName = "";
    private string description = "";
    private bool saving;

    protected override void OnInitialized()
    {
        if (Permission is not null)
        {
            code = Permission.Code;
            name = Permission.Name;
            groupName = Permission.GroupName;
            description = Permission.Description;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(code) || string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(groupName)) return;

        saving = true;
        try
        {
            if (IsEdit)
                await Api.UpdatePermission(Permission!.Id, new UpdatePermissionRequest(code, name, description, groupName));
            else
                await Api.CreatePermission(new CreatePermissionRequest(code, name, description, groupName));

            Snackbar.Add(IsEdit ? "Permission updated." : "Permission created.", Severity.Success);
            await OnSave.InvokeAsync();
            MudDialog.Close();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        saving = false;
    }
}
