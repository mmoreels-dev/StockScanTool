@page "/Error"
@inject NavigationManager Nav

<PageTitle>Error - StockScanTool</PageTitle>

<MudPaper Elevation="2" Style="padding:32px;border-radius:12px;max-width:600px;margin:48px auto;">
    <div style="text-align:center;margin-bottom:16px;">
        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Style="color:#D32F2F;font-size:3rem;" />
    </div>
    <MudText Typo="Typo.h4" Style="font-weight:700;text-align:center;margin-bottom:8px;">Something went wrong</MudText>
    <MudText Typo="Typo.body1" Style="color:#757575;text-align:center;margin-bottom:24px;">
        An unexpected error occurred. Please try again.
    </MudText>
    <div style="text-align:center;">
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Style="text-transform:none;">
            Go to Dashboard
        </MudButton>
    </div>
</MudPaper>
