@page "/inventory"
@rendermode InteractiveServer
@using StockScanTool.Web.Services
@inject ApiClient Api

<h3>Inventory Management</h3>

@if (showForm)
{
    <div class="form-card">
        <h4>Update Stock Level</h4>
        <div class="form-grid">
            <div class="form-group">
                <label>Store</label>
                <select @bind="selectedStoreId">
                    <option value="0">-- All Stores --</option>
                    @foreach (var s in stores)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Product</label>
                <select @bind="selectedProductId">
                    <option value="0">-- Select Product --</option>
                    @foreach (var p in products)
                    {
                        <option value="@p.Id">@p.Name (@p.Sku)</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Quantity On Hand</label>
                <input type="number" min="0" @bind="quantity" />
            </div>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="Save"
                    disabled="@(selectedStoreId == 0 || selectedProductId == 0)">Save</button>
            <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
        </div>
        @if (!string.IsNullOrEmpty(error))
        {
            <p class="error">@error</p>
        }
    </div>
}

@if (!showForm)
{
    <div style="display:flex; gap:12px; align-items:center; margin-bottom:16px;">
        <button class="btn btn-primary" @onclick="NewInventory">+ Set Stock Level</button>
        <select @bind="filterStoreId" @bind:after="FilterChanged" style="padding:8px; border:1px solid #ddd; border-radius:4px;">
            <option value="0">All Stores</option>
            @foreach (var s in stores)
            {
                <option value="@s.Id">@s.Name</option>
            }
        </select>
    </div>
}

@if (items is null)
{
    <p>Loading...</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr><th>Product</th><th>Barcode</th><th>Store</th><th>Qty On Hand</th></tr>
        </thead>
        <tbody>
            @foreach (var i in items)
            {
                <tr class="@(i.QuantityOnHand == 0 ? "row-danger" : i.QuantityOnHand <= 5 ? "row-warning" : "")">
                    <td>@i.ProductName</td>
                    <td><code>@i.ProductBarcode</code></td>
                    <td>@i.StoreName</td>
                    <td>@i.QuantityOnHand</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<InventoryDto>? items;
    private List<StoreDto> stores = new();
    private List<ProductDto> products = new();
    private bool showForm;
    private string error = "";

    private int filterStoreId;
    private int selectedStoreId, selectedProductId, quantity;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            stores = await Api.GetStores();
            products = await Api.GetProducts();
            items = await Api.GetInventory();
        }
        catch
        {
            error = "Could not connect to the API. Make sure the API server is running.";
        }
    }

    private async Task FilterChanged()
    {
        items = filterStoreId == 0
            ? await Api.GetInventory()
            : await Api.GetInventoryByStore(filterStoreId);
    }

    private void NewInventory()
    {
        selectedStoreId = selectedProductId = 0; quantity = 0;
        showForm = true; error = "";
    }

    private void Cancel() { showForm = false; error = ""; }

    private async Task Save()
    {
        try
        {
            await Api.UpsertInventory(new UpdateInventoryRequest(selectedProductId, selectedStoreId, quantity));
            showForm = false;
            await FilterChanged();
        }
        catch (Exception ex) { error = ex.Message; }
    }
}
