@page "/inventory"
@inject ApiClient Api
@inject AuthStateService AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Inventory - StockScanTool</PageTitle>

<PageHeader Title="Inventory" ButtonText="Set Stock Level" ButtonIcon="@Icons.Material.Filled.Add" OnAdd="NewInventory" />

@if (loading)
{
    <div style="display:flex;justify-content:center;padding:48px;">
        <MudProgressCircular Size="Size.Large" Indeterminate="true" Color="Color.Primary" />
    </div>
}
else if (!string.IsNullOrEmpty(error))
{
    <ErrorAlert Message="@error" />
}
else
{
    <MudDataGrid T="InventoryDto" Items="@FilteredInventory" Hover="true" Dense="true"
                 SortMode="SortMode.Single" Elevation="2" Style="border-radius:12px;overflow:hidden;"
                 Filterable="true" Groupable="false"
                 RowClassFunc="@((item, _) => item.QuantityOnHand == 0 ? "row-danger" : item.QuantityOnHand <= 5 ? "row-warning" : "")">
        <ToolBarContent>
            <MudSelect T="int" @bind-Value="filterStoreId" Label="Filter by Store" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Style="max-width:200px;" Clearable="true">
                <MudSelectItem Value="0">All Stores</MudSelectItem>
                @foreach (var s in stores)
                {
                    <MudSelectItem Value="@s.Id">@s.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSpacer />
            <MudTextField @bind-Value="searchText" Placeholder="Search products..."
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium" Immediate="true"
                          DebounceInterval="300" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Style="max-width:300px;" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.ProductName" Title="Product" />
            <PropertyColumn Property="x => x.ProductBarcode" Title="Barcode">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.QrCode">
                        @context.Item.ProductBarcode
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.StoreName" Title="Store" />
            <PropertyColumn Property="x => x.QuantityOnHand" Title="Qty On Hand">
                <CellTemplate>
                    @if (context.Item.QuantityOnHand == 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">
                            @context.Item.QuantityOnHand
                        </MudChip>
                    }
                    else if (context.Item.QuantityOnHand <= 5)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                            @context.Item.QuantityOnHand
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">
                            @context.Item.QuantityOnHand
                        </MudChip>
                    }
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="Actions" Sortable="false" Filterable="false" Align="Align.End">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                   OnClick="() => Edit(context.Item)" Title="Edit" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Style="padding:16px;color:#757575;">No inventory records found.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="InventoryDto" PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    private List<InventoryDto>? items;
    private List<StoreDto> stores = new();
    private List<ProductDto> products = new();
    private string error = "";
    private bool loading = true;
    private string searchText = "";
    private int filterStoreId;

    private IEnumerable<InventoryDto> FilteredInventory => items?.Where(i =>
        (filterStoreId == 0 || i.StoreId == filterStoreId) &&
        (string.IsNullOrEmpty(searchText) ||
         i.ProductName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
         i.ProductBarcode.Contains(searchText, StringComparison.OrdinalIgnoreCase))
    ) ?? [];

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        if (!AuthState.IsAuthenticated) { Nav.NavigateTo("/login", forceLoad: true); return; }
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        try
        {
            stores = (await Api.GetStores()).ToList();
            products = (await Api.GetProducts()).ToList();
            items = (await Api.GetInventory()).ToList();
            error = "";
        }
        catch (UnauthorizedAccessException) { Nav.NavigateTo("/login", forceLoad: true); return; }
        catch { error = "Could not connect to the API."; }
        loading = false;
    }

    private void NewInventory() => ShowDialog(null);
    private void Edit(InventoryDto item) => ShowDialog(item);

    private async Task ShowDialog(InventoryDto? item)
    {
        var parameters = new DialogParameters<InventoryDialog>
        {
            { x => x.Item, item },
            { x => x.Stores, stores },
            { x => x.Products, products },
            { x => x.OnSave, EventCallback.Factory.Create(this, LoadData) }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<InventoryDialog>(item == null ? "Set Stock Level" : "Update Stock Level", parameters, options);
    }
}
