@inherits LayoutComponentBase
@inject AuthStateService AuthState
@inject NavigationManager Nav
@using StockScanTool.Shared.Themes

<MudThemeProvider Theme="StockScanToolTheme.Default" />

<MudLayout>
    <MudAppBar Elevation="0">
        <MudSpacer />
        <MudText Typo="Typo.h6" Style="color:white;font-weight:600;">StockScanTool</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Style="color:#FF6D00;margin-right:12px;">@displayName</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit"
                       OnClick="Logout" Title="Logout" />
    </MudAppBar>

    <MudDrawer Open="true" Fixed="true"
               Elevation="2">
        <MudDrawerHeader>
            <div style="display:flex;align-items:center;gap:10px;padding:8px 0;">
                <div style="width:36px;height:36px;background:#FF6D00;border-radius:8px;display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:1rem;">S</div>
                <MudText Typo="Typo.h6" Style="color:white;font-weight:600;">StockScanTool</MudText>
            </div>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                Dashboard
            </MudNavLink>
            <MudNavLink Href="/stores" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Store">
                Stores
            </MudNavLink>
            <MudNavLink Href="/products" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inventory2">
                Products
            </MudNavLink>
            <MudNavLink Href="/devices" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.DeviceHub">
                Devices
            </MudNavLink>
            <MudNavLink Href="/inventory" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Warehouse">
                Inventory
            </MudNavLink>
            <MudNavLink Href="/sales" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Receipt">
                Sales
            </MudNavLink>
            <MudDivider Style="margin:8px 0;background:#333;" />
            <MudText Typo="Typo.caption" Style="color:#757575;padding:4px 16px;text-transform:uppercase;">Administration</MudText>
            <MudNavLink Href="/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">
                Users
            </MudNavLink>
            <MudNavLink Href="/roles" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">
                Roles
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Style="background:#F5F5F5;min-height:100vh;">
        <div style="padding:24px;">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private string displayName = "User";

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        displayName = AuthState.DisplayName;
    }

    private async Task Logout()
    {
        await AuthState.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
