<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StockScanTool.Scanner.Views.LoginPage"
             Title="StockScanTool"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <Label Text="StockScanTool"
                   Style="{StaticResource TitleStyle}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,5" />

            <Label Text="Scan &amp; Sell"
                   FontSize="16"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20" />

            <Frame BackgroundColor="{StaticResource CardColor}"
                   CornerRadius="12"
                   Padding="20"
                   HasShadow="True">

                <VerticalStackLayout Spacing="16">
                    <Label Text="Server Address"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryColor}" />

                    <Entry x:Name="ServerEntry"
                           Placeholder="http://192.168.1.100:5168"
                           Style="{StaticResource EntryStyle}"
                           Keyboard="Url" />

                    <Label Text="Device API Key"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryColor}" />

                    <Entry x:Name="ApiKeyEntry"
                           Placeholder="Enter your device API key"
                           Style="{StaticResource EntryStyle}"
                           IsPassword="True" />

                    <Button x:Name="LoginButton"
                            Text="Connect"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnLoginClicked" />

                    <ActivityIndicator x:Name="LoginSpinner"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="{StaticResource PrimaryColor}" />

                    <Label x:Name="ErrorLabel"
                           TextColor="{StaticResource DangerColor}"
                           FontSize="13"
                           IsVisible="False"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
